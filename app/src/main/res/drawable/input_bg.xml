<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer gradient stroke -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#7C3AED"
                android:endColor="#06B6D4"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Inner fill -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1E1550" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
